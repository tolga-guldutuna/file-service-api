{
  "info": {
    "name": "File Service API - COMPLETE",
    "description": "Complete API collection for File Service including Authentication and ALL File Management endpoints (Upload, List, Metadata, Download, Update, Delete)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "file-service-api-complete",
    "version": "1.1.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "publicId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('ownerId', jsonData.id);",
                  "    console.log('User registered with ID: ' + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"confirmPassword\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a new user account with the provided credentials."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.accessToken);",
                  "    pm.collectionVariables.set('ownerId', jsonData.user.id);",
                  "    console.log('Token saved: ' + jsonData.accessToken.substring(0, 20) + '...');",
                  "    console.log('Owner ID: ' + jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates a user and returns a JWT access token."
          },
          "response": []
        }
      ],
      "description": "Endpoints for user authentication and registration"
    },
    {
      "name": "File Management",
      "item": [
        {
          "name": "Upload File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('publicId', jsonData.publicId);",
                  "    console.log('File uploaded with publicId: ' + jsonData.publicId);",
                  "    console.log('File name: ' + jsonData.originalName);",
                  "    console.log('File size: ' + jsonData.sizeBytes + ' bytes');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a file to upload (PNG, JPEG, JPG, DOCX, PDF, XLSX - max 5MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files?ownerId={{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files"
              ],
              "query": [
                {
                  "key": "ownerId",
                  "value": "{{ownerId}}"
                }
              ]
            },
            "description": "Uploads a new file for the given owner. Select a file in the Body tab. Max size: 5MB. Allowed extensions: PNG, JPEG, JPG, DOCX, PDF, XLSX"
          },
          "response": []
        },
        {
          "name": "List Files",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('Found ' + jsonData.length + ' file(s)');",
                  "    if (jsonData.length > 0) {",
                  "        console.log('First file: ' + jsonData[0].originalName + ' (' + jsonData[0].publicId + ')');",
                  "        // Auto-set the publicId from the first file for testing",
                  "        pm.collectionVariables.set('publicId', jsonData[0].publicId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files?ownerId={{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files"
              ],
              "query": [
                {
                  "key": "ownerId",
                  "value": "{{ownerId}}"
                }
              ]
            },
            "description": "Returns a lightweight list of files that belong to the specified owner."
          },
          "response": []
        },
        {
          "name": "Get File Metadata",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('File Details:');",
                  "    console.log('- Name: ' + jsonData.originalName);",
                  "    console.log('- Extension: ' + jsonData.extension);",
                  "    console.log('- Size: ' + jsonData.sizeBytes + ' bytes');",
                  "    console.log('- Content Type: ' + jsonData.contentType);",
                  "    console.log('- Storage Path: ' + jsonData.storagePath);",
                  "    console.log('- Created: ' + jsonData.createdAt);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{publicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{publicId}}"
              ]
            },
            "description": "Fetches detailed metadata for a single file identified by its public id."
          },
          "response": []
        },
        {
          "name": "Download File Content",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var contentDisposition = pm.response.headers.get('Content-Disposition');",
                  "    var contentType = pm.response.headers.get('Content-Type');",
                  "    var contentLength = pm.response.headers.get('Content-Length');",
                  "    ",
                  "    console.log('File downloaded successfully!');",
                  "    console.log('Content-Type: ' + contentType);",
                  "    console.log('Content-Length: ' + contentLength + ' bytes');",
                  "    console.log('Content-Disposition: ' + contentDisposition);",
                  "    ",
                  "    // Extract filename from Content-Disposition header",
                  "    if (contentDisposition) {",
                  "        var filenameMatch = contentDisposition.match(/filename=\"?(.+?)\"?$/);",
                  "        if (filenameMatch) {",
                  "            console.log('Filename: ' + filenameMatch[1]);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{publicId}}/content?ownerId={{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{publicId}}",
                "content"
              ],
              "query": [
                {
                  "key": "ownerId",
                  "value": "{{ownerId}}"
                }
              ]
            },
            "description": "Downloads the actual file content as a byte stream. The response includes proper headers (Content-Type, Content-Disposition, Content-Length) for browser download."
          },
          "response": []
        },
        {
          "name": "Update File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('File updated successfully!');",
                  "    console.log('Public ID (unchanged): ' + jsonData.publicId);",
                  "    console.log('New file name: ' + jsonData.originalName);",
                  "    console.log('New file size: ' + jsonData.sizeBytes + ' bytes');",
                  "    console.log('New storage path: ' + jsonData.storagePath);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a new file to replace the existing one (PNG, JPEG, JPG, DOCX, PDF, XLSX - max 5MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/{{publicId}}?ownerId={{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{publicId}}"
              ],
              "query": [
                {
                  "key": "ownerId",
                  "value": "{{ownerId}}"
                }
              ]
            },
            "description": "Updates an existing file by replacing it with new content. The public ID remains unchanged. Select a new file in the Body tab. Max size: 5MB. Allowed extensions: PNG, JPEG, JPG, DOCX, PDF, XLSX"
          },
          "response": []
        },
        {
          "name": "Delete File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 204) {",
                  "    console.log('File deleted successfully (soft delete)');",
                  "    console.log('Deleted publicId: ' + pm.collectionVariables.get('publicId'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{publicId}}?ownerId={{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{publicId}}"
              ],
              "query": [
                {
                  "key": "ownerId",
                  "value": "{{ownerId}}"
                }
              ]
            },
            "description": "Deletes a file identified by its public id for the specified owner (soft delete - marks as deleted but keeps in database)."
          },
          "response": []
        }
      ],
      "description": "Complete file management endpoints: upload, list, metadata, download, update and delete",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script",
          "console.log('=== File Service API Request ===');",
          "console.log('Base URL: ' + pm.collectionVariables.get('baseUrl'));",
          "console.log('Token: ' + (pm.collectionVariables.get('token') ? 'Set' : 'Not set'));",
          "console.log('Owner ID: ' + pm.collectionVariables.get('ownerId'));",
          "console.log('Public ID: ' + pm.collectionVariables.get('publicId'));"
        ]
      }
    }
  ]
}
